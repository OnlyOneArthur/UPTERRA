# UPTERRA Environment Variables
# Salin file ini menjadi .env dan isi nilai yang sesuai
# JANGAN commit file .env ke GitHub!

# ======================================================
# GEMINI LIVE API (Native WebSocket — Gemini Live mode)
# ======================================================
# Dapatkan di: https://aistudio.google.com/app/apikey
# Model yang dipakai: gemini-2.0-flash-live-001
# Dipakai oleh: src/hooks/useGeminiLive.js + src/services/geminiLive.js
VITE_GEMINI_API_KEY=isi_gemini_api_key_kamu_di_sini

# ======================================================
# OPENROUTER API (Fallback — Camera & Voice mode)
# ======================================================
# Dapatkan di: https://openrouter.ai/keys
# Model yang dipakai: google/gemini-2.0-flash-lite:free
# Dipakai oleh: src/hooks/useScanAI.js
VITE_OPENROUTER_API_KEY=isi_openrouter_api_key_kamu_di_sini

# ======================================================
# SUPABASE (Opsional — auth & database)
# ======================================================
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ======================================================
# APP CONFIG
# ======================================================
VITE_APP_NAME=UPTERRA
VITE_APP_VERSION=1.0.0
