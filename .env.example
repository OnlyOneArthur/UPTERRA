# UPTERRA Environment Variables
# Salin file ini menjadi .env dan isi nilai yang sesuai
# JANGAN commit file .env ke GitHub!

# === GEMINI LIVE API ===
# Dapatkan di: https://aistudio.google.com/app/apikey
# Model yang dipakai: gemini-2.0-flash-live-001 (Live API / WebSocket)
VITE_GEMINI_API_KEY=isi_api_key_kamu_di_sini

# === SUPABASE (Opsional - untuk fitur auth & database) ===
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# === APP CONFIG ===
VITE_APP_NAME=UPTERRA
VITE_APP_VERSION=1.0.0
